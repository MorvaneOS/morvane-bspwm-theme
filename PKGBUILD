# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for bspwm. Everything installed is generated by tools/build.py
# and committed, so building the package needs nothing but the repo.

pkgname=morvane-bspwm-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for bspwm: border and dmenu colours and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-bspwm-theme'
# The configs are bspwm's examples with the MorvaneOS look added
license=(BSD-2-Clause)
depends=(
  bspwm
  sxhkd
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wm-theme    # urxvt and friends
  morvane-wallpapers
  xwallpaper
)

package() {
  # The installer copies these to new users' ~/.config (see README)
  install -Dm755 "$startdir"/config/bspwmrc -t "$pkgdir/usr/share/morvane-bspwm-theme/"
  install -Dm644 "$startdir"/config/sxhkdrc -t "$pkgdir/usr/share/morvane-bspwm-theme/"
}
